<Window x:Class="Quản_lý_công_tơ_điện.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ Thống Quản Lý Công Tơ Điện" Height="650" Width="1100" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2c3e50" Padding="10">
            <StackPanel>
                <TextBlock Text="DANH MỤC" Foreground="White" FontSize="18" FontWeight="Bold" Margin="10,10,10,20" HorizontalAlignment="Center"/>

                <Button x:Name="btnBM1" Content="1. Đề nghị cấp điện" Height="40" Margin="0,5" 
                        Background="#34495e" Foreground="White" BorderThickness="0" 
                        Click="btnBM1_Click"/>

                <Button x:Name="btnBM2" Content="2. Biên bản cấp điện" Height="40" Margin="0,5" 
                        Background="#34495e" Foreground="White" BorderThickness="0" 
                        Click="btnBM2_Click"/>

                <Button x:Name="btnBM3" Content="3. Tra cứu đề nghị" Height="40" Margin="0,5" 
                        Background="#34495e" Foreground="White" BorderThickness="0" 
                        Click="btnBM3_Click"/>
            </StackPanel>
        </Border>

        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="20"/>
    </Grid>
</Window>