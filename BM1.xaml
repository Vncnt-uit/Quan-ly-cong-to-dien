<UserControl x:Class="Quản_lý_công_tơ_điện.BM1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quản_lý_công_tơ_điện"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White">
    <Grid>
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Thông tin khách hàng" FontSize="24" FontWeight="Bold" Foreground="#3b5998" Margin="0,0,0,20"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="SỐ CCCD" FontWeight="SemiBold"/>

                    <TextBox x:Name="txtCCCD" TextChanged="CheckIfFormIsEmpty" Height="25"
                               TextWrapping="Wrap"
                               VerticalContentAlignment="Center" Margin="0,0,0,0" 
                               LostFocus="txtCCCD_LostFocus" 
                               BorderBrush="Gray" BorderThickness="1"/>

                    <TextBlock x:Name="lblCCCDError" Text="* Số CCCD này đã được đăng ký trước đó!" 
           Foreground="Red" FontSize="11" FontStyle="Italic" 
           Visibility="Collapsed" Margin="0,0,0,0"/>
                </StackPanel>

                <TextBlock Text="HỌ VÀ TÊN" FontWeight="SemiBold"/>

                <TextBox x:Name="txtHoTen" TextChanged="CheckIfFormIsEmpty" Height="25" TextWrapping="Wrap" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="NĂM SINH" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtNamSinh" TextChanged="CheckIfFormIsEmpty" Height="25" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="SỐ ĐIỆN THOẠI" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtSoDienThoai" TextChanged="CheckIfFormIsEmpty" TextWrapping="Wrap" Height="25" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="EMAIL" FontWeight="SemiBold"/>
                <TextBox x:Name="txtEmail" TextChanged="CheckIfFormIsEmpty" Height="25" VerticalContentAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,15"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock Text="Thông tin yêu cầu" FontSize="24" FontWeight="Bold" Foreground="#3b5998" Margin="0,0,0,20"/>

                <Border Background="#f0f4f8" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Mã yêu cầu" Grid.Row="0" Grid.Column="0"/>
                        <TextBlock x:Name="lblMaYeuCau" Text="&lt;Tự động sinh&gt;" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                        <TextBlock Text="Thời gian gửi yêu cầu" Grid.Row="2" Grid.Column="0"/>
                        <TextBlock x:Name="lblThoiGian" Text="&lt;Lấy từ hệ thống&gt;" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <TextBlock Text="ĐỊA CHỈ ĐĂNG KÝ" FontWeight="SemiBold"/>
                <TextBox x:Name="txtDiaChi" TextChanged="CheckIfFormIsEmpty" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,5" Padding="8,6"/>
                <TextBlock Text="* Nhập số nhà, tên đường, phường/xã..." FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="MỤC ĐÍCH SỬ DỤNG" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cboMucDich" Height="25" VerticalContentAlignment="Center" SelectionChanged="cboMucDich_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="SỐ PHA" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cboSoPha" SelectionChanged="CheckIfFormIsEmpty" Height="25" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnHuy" Content="HỦY" Width="100" Height="35" Background="White" BorderBrush="Gray" Margin="0,0,10,0" Click="btnHuy_Click"/>
                    <Button x:Name="btnGui" Content="GỬI ĐỀ NGHỊ" Width="120" Height="35" Background="#4e73df" Foreground="White" BorderThickness="0" IsEnabled="False" Opacity="0.9" Click="btnGui_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
