<Window x:Class="Quản_lý_công_tơ_điện.Views.DanhMuc"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Quản_lý_công_tơ_điện.Views"
        xmlns:viewmodels="clr-namespace:Quản_lý_công_tơ_điện.ViewModels"
        Title="Hệ Thống Quản Lý Công Tơ Điện" Height="900" Width="1400" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" MouseDown="Window_MouseDown" UseLayoutRounding="True">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5"/>
        </Storyboard>

        <DataTemplate DataType="{x:Type viewmodels:DeNghiCapDienViewModel}">
            <views:DeNghiCapDien/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BienBanCapDienViewModel}">
            <views:BienBanCapDien/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TraCuuDeNghiViewModel}">
            <views:TraCuuDeNghi/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PhieuGhiChiSoDienViewModel}">
            <views:PhieuGhiChiSoDien />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:HoaDonTienDienViewModel}">
            <views:HoaDonTienDien />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ThongKeDienViewModel}">
            <views:ThongKeDien />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CauHinhHeThongViewModel}">
            <views:CauHinhHeThong />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TrangChuViewModel}">
            <views:TrangChuView/>
        </DataTemplate>

        <Style x:Key="MenuButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,4"/>

            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="SidebarMenu"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0f172a"/>
                                <Setter Property="Foreground" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainLayout" Focusable="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE8F1FD" Offset="0"/>
                <GradientStop Color="#FFF3E6F9" Offset="0.5"/>
                <GradientStop Color="#FFEBF6FA" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1e293b" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="DANH MỤC" Foreground="#94a3b8" FontSize="13" FontWeight="Bold" Margin="0,10,0,20" HorizontalAlignment="Center"/>

                    <RadioButton Style="{StaticResource MenuButton}" Content="1. Đề nghị cấp điện" Command="{Binding NavigateBM1Command}" IsChecked="{Binding IsMenu1Checked, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource MenuButton}" Content="2. Biên bản cấp điện" Command="{Binding NavigateBM2Command}" IsChecked="{Binding IsMenu2Checked, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource MenuButton}" Content="3. Tra cứu đề nghị" Command="{Binding NavigateBM3Command}" IsChecked="{Binding IsMenu3Checked, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource MenuButton}" Content="4. Ghi chỉ số điện" Command="{Binding NavigateBM4Command}" IsChecked="{Binding IsMenu4Checked, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource MenuButton}" Content="5. Lập hóa đơn tiền điện" Command="{Binding NavigateBM5Command}" IsChecked="{Binding IsMenu5Checked, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource MenuButton}" Content="6. Thống kê sản lượng điện" Command="{Binding NavigateBM6Command}" IsChecked="{Binding IsMenu6Checked, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <Separator Background="#334155" Margin="0,10,0,15" Height="1"/>

                    <RadioButton Style="{StaticResource MenuButton}" HorizontalContentAlignment="Center" Padding="0" Content="Cấu hình hệ thống" Command="{Binding NavigateCauHinhHeThongCommand}" IsChecked="{Binding IsMenuCauHinhChecked, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Margin="20"
                Content="{Binding CurrentViewModel, NotifyOnTargetUpdated=True, Mode=OneWay}">

            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                </EventTrigger>
            </ContentControl.Triggers>

        </ContentControl>
    </Grid>
</Window>