<UserControl x:Class="Quản_lý_công_tơ_điện.Views.PhieuGhiChiSoDien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="Transparent"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#d6e4ff"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3b5998"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#bacdf2"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CenterWrapText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="CenterWrapTextBox" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
            </Style.Resources>
        </Style>

        <Style x:Key="BaseCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="#5475e6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReadOnlyCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource BaseCellStyle}">
            <Setter Property="Background" Value="#f1f3f5"/>
        </Style>

        <Style x:Key="EditableCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource BaseCellStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30" HorizontalAlignment="Center">
            <TextBlock FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#6b87f2" Offset="0"/>
                        <GradientStop Color="#88a1f4" Offset="0.6"/>
                        <GradientStop Color="#c3caf8" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
                <Run Text="Ghi chỉ số điện định kỳ"/>
            </TextBlock>
            <TextBlock Text="Cập nhật chỉ số công tơ điện định kỳ nhằm quản lý sản lượng tiêu thụ và hỗ trợ phát hành hóa đơn." 
                       FontSize="15" Foreground="#555555" HorizontalAlignment="Center" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#60FFFFFF" BorderBrush="#ffffff" BorderThickness="2" CornerRadius="15" Padding="25">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="20" Opacity="0.08"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontSize="20" FontWeight="Bold" Foreground="#3b5998" Text="Phiếu ghi chỉ số điện định kỳ"/>

                    <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,0,0"
                               Text="{Binding StatusMessage, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#e74a3b"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessStatus}" Value="True">
                                        <Setter Property="Foreground" Value="#1cc88a"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Kỳ ghi chỉ số" FontWeight="SemiBold" Foreground="#555" FontSize="12" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                        <Border CornerRadius="16" Height="32" Background="#f1f3f5" BorderBrush="#e0e0e0" BorderThickness="1">
                            <TextBox Text="{Binding KyGhiChiSo}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="12,0" VerticalContentAlignment="Center" Foreground="#555" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,15,0">
                        <TextBlock Text="Ngày ghi" FontWeight="SemiBold" Foreground="#555" FontSize="12" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                        <Border CornerRadius="16" Height="32" Background="#f1f3f5" BorderBrush="#e0e0e0" BorderThickness="1">
                            <TextBox Text="{Binding NgayGhi}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="12,0" VerticalContentAlignment="Center" Foreground="#555" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="Nhân viên ghi" FontWeight="SemiBold" Foreground="#555" FontSize="12" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                        <Border CornerRadius="16" Height="32" Background="White" BorderBrush="#e0e0e0" BorderThickness="1">
                            <TextBox Text="{Binding NhanVienGhi, UpdateSourceTrigger=LostFocus}" Background="Transparent" BorderThickness="0" Padding="12,0" VerticalContentAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding NhanVienGhiErrorMessage}" 
                                   Foreground="#e74a3b" FontSize="11" Margin="10,4,0,0" FontStyle="Italic"
                                   Visibility="{Binding HasNhanVienGhiError, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" VerticalAlignment="Top" BorderBrush="#bacdf2" BorderThickness="1" CornerRadius="12" Background="White">
                    <Grid x:Name="DataGridContainer">
                        <Grid.OpacityMask>
                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                                <VisualBrush.Visual>
                                    <Border Background="Black" CornerRadius="11" 
                                            Width="{Binding ActualWidth, ElementName=DataGridContainer}" 
                                            Height="{Binding ActualHeight, ElementName=DataGridContainer}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Grid.OpacityMask>

                        <DataGrid ItemsSource="{Binding DanhSachGhiDien, IsAsync=True}" 
                                  AutoGenerateColumns="False" HeadersVisibility="Column"
                                  GridLinesVisibility="All" HorizontalGridLinesBrush="#bacdf2" VerticalGridLinesBrush="#bacdf2"
                                  Background="Transparent" BorderThickness="0"
                                  RowHeight="42" AlternatingRowBackground="#eff4fd" VerticalContentAlignment="Center" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  SelectionUnit="Cell" CanUserAddRows="False" CanUserResizeRows="False"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" IsReadOnly="True" Width="50" ElementStyle="{StaticResource CenterWrapText}" CellStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <DataGridTemplateColumn Header="MÃ CÔNG TƠ" Width="1.5*" CellStyle="{StaticResource EditableCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding MaCongTo, UpdateSourceTrigger=LostFocus}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource CenterWrapTextBox}">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsSelected}" Value="True">
                                                                <Setter Property="FocusManager.FocusedElement" Value="{Binding RelativeSource={RelativeSource Self}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="TÊN KHÁCH HÀNG" Binding="{Binding TenKhachHang}" IsReadOnly="True" Width="2*" ElementStyle="{StaticResource CenterWrapText}" CellStyle="{StaticResource ReadOnlyCellStyle}"/>
                                <DataGridTextColumn Header="ĐỊA CHỈ" Binding="{Binding DiaChi}" IsReadOnly="True" Width="2.5*" ElementStyle="{StaticResource CenterWrapText}" CellStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <DataGridTextColumn Header="CHỈ SỐ CŨ" Binding="{Binding ChiSoCu}" IsReadOnly="True" Width="1.2*" CellStyle="{StaticResource ReadOnlyCellStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterWrapText}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="CHỈ SỐ MỚI" Width="1.2*" CellStyle="{StaticResource EditableCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ChiSoMoiText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource CenterWrapTextBox}">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="Black"/>

                                                        <Setter Property="IsReadOnly" Value="True"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanEnterChiSoMoi}" Value="True">
                                                                <Setter Property="IsReadOnly" Value="False"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsSelected}" Value="True">
                                                                <Setter Property="FocusManager.FocusedElement" Value="{Binding RelativeSource={RelativeSource Self}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="SẢN LƯỢNG TIÊU THỤ" Binding="{Binding SanLuongTieuThu}" IsReadOnly="True" Width="1.8*" CellStyle="{StaticResource ReadOnlyCellStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterWrapText}">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="Red"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DeleteCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Xóa dòng này">
                                                <TextBlock Text="✕" Foreground="#e74a3b" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,35,0,0">

                    <Button Content="HỦY" Command="{Binding HuyCommand}" FontWeight="Bold" Width="100" Height="40" Background="White" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17.5"/>
                            </Style>
                        </Button.Resources>
                        <Button.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                        </Button.Effect>
                    </Button>

                    <Button Content="💾 LƯU PHIẾU" Command="{Binding LuuCommand}" FontWeight="Bold" Width="140" Height="40" Background="#4e73df" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17.5"/>
                            </Style>
                        </Button.Resources>
                        <Button.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                        </Button.Effect>
                    </Button>

                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>