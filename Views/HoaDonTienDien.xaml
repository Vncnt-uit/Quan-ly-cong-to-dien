<UserControl x:Class="Quản_lý_công_tơ_điện.Views.HoaDonTienDien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100" 
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#cbd5e1"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#cbd5e1"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
            </Style.Resources>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#d6e4ff"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#001A42"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#bacdf2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#424754"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5,0,0,5"/>
        </Style>

        <Style x:Key="ReadOnlyPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#94a3b8"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25" HorizontalAlignment="Center">
            <TextBlock FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#305CF7" Offset="0"/>
                        <GradientStop Color="#7F9EFB" Offset="0.6"/>
                        <GradientStop Color="#CCE1FF" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
                <Run Text="Lập hóa đơn tiền điện"/>
            </TextBlock>
            <TextBlock Text="Lập và phát hành hóa đơn thanh toán định kỳ dựa trên dữ liệu chỉ số công tơ và quy định giá bán lẻ điện." 
                       FontSize="14" Foreground="#464555" HorizontalAlignment="Center" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#60FFFFFF" BorderBrush="#ffffff" BorderThickness="2" CornerRadius="15" Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="20" Opacity="0.08"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Lập hóa đơn tiền điện" FontSize="25" FontWeight="SemiBold" Foreground="#545997" Margin="0,0,0,20"/>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nhập thông tin chỉ số" FontSize="16" FontWeight="SemiBold" Foreground="#0058BE" Margin="0,0,0,10"/>

                        <TextBlock Text="Kỳ ghi chỉ số" Style="{StaticResource FormLabel}"/>
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tháng" FontSize="11" Foreground="#424754" Margin="5,0,0,2"/>
                                <Border CornerRadius="16" Height="34" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" Padding="6,5">
                                    <ComboBox ItemsSource="{Binding DanhSachThang}" SelectedItem="{Binding Thang}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" IsEditable="True" IsReadOnly="True" ForceCursor="True" Cursor="Arrow">
                                        <ComboBox.Resources>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Cursor" Value="Arrow"/>
                                                <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
                                                <Setter Property="ForceCursor" Value="True"/>
                                            </Style>
                                        </ComboBox.Resources>
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Năm" FontSize="11" Foreground="#424754" Margin="5,0,0,2"/>
                                <Border CornerRadius="16" Height="34" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" Padding="6,5">
                                    <ComboBox ItemsSource="{Binding DanhSachNam}" SelectedItem="{Binding Nam}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" IsEditable="True" IsReadOnly="True" ForceCursor="True" Cursor="Arrow">
                                        <ComboBox.Resources>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Cursor" Value="Arrow"/>
                                                <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
                                                <Setter Property="ForceCursor" Value="True"/>
                                            </Style>
                                        </ComboBox.Resources>
                                    </ComboBox>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Mã công tơ" Style="{StaticResource FormLabel}"/>
                        <Border CornerRadius="16" Height="34" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,0,2" Padding="3,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMaCongToError}" Value="True">
                                            <Setter Property="BorderBrush" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <ComboBox ItemsSource="{Binding DanhSachMaCongTo}" Text="{Binding MaCongTo, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Margin="5,4">
                            </ComboBox>
                        </Border>
                        <TextBlock Text="{Binding MaCongToErrorMessage}" Foreground="#e74a3b" FontSize="11" FontStyle="Italic" Visibility="{Binding HasMaCongToError, Converter={StaticResource BoolToVis}}" Margin="10,0,0,10" MinHeight="15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Chỉ số cũ" Style="{StaticResource FormLabel}" Margin="0,10,0,5"/>
                                <Border Style="{StaticResource ReadOnlyPill}">
                                    <TextBox Text="{Binding ChiSoCu}" IsReadOnly="True" Background="Transparent"  BorderThickness="0" Padding="15,0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" FontWeight="SemiBold" Foreground="Black"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Chỉ số mới" Style="{StaticResource FormLabel}" Margin="0,10,0,5"/>
                                <Border Style="{StaticResource ReadOnlyPill}">
                                    <TextBox Text="{Binding ChiSoMoi}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="15,0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" FontWeight="SemiBold" Foreground="Black"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Thông tin khách hàng" FontSize="16" FontWeight="SemiBold" Foreground="#0B1C30" Margin="0,20,0,15"/>

                        <TextBlock Text="Họ tên khách hàng" Style="{StaticResource FormLabel}"/>
                        <Border Style="{StaticResource ReadOnlyPill}">
                            <TextBox Text="{Binding HoTenKhachHang}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="15,0" VerticalContentAlignment="Center" FontWeight="SemiBold" Foreground="Black"/>
                        </Border>

                        <TextBlock Text="Địa chỉ lắp đặt" Style="{StaticResource FormLabel}"/>
                        <Border Style="{StaticResource ReadOnlyPill}" Margin="0,0,0,23">
                            <TextBox Text="{Binding DiaChiLapDat}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="15,0" VerticalContentAlignment="Center" FontWeight="SemiBold" Foreground="Black"/>
                        </Border>

                        <Border CornerRadius="16" Background="#eef2ff" BorderBrush="#c7d2fe" BorderThickness="1" Padding="15,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="SẢN LƯỢNG TIÊU THỤ" FontSize="10" FontWeight="SemiBold" Foreground="#0058BE" HorizontalAlignment="Center"/>
                                    <Border Background="White" CornerRadius="12" Margin="0,6,0,0" Padding="0,3" MinWidth="150" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding SanLuongTieuThu}" FontSize="14" FontWeight="Bold" Foreground="#3b82f6" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1" Fill="#cbd5e1" Margin="10,0"/>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="TỔNG TIỀN THANH TOÁN" FontSize="10" FontWeight="SemiBold" Foreground="#924700" HorizontalAlignment="Center"/>
                                    <Border Background="White" CornerRadius="12" Margin="0,6,0,0" Padding="0,3" MinWidth="170" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TongTienText}" FontSize="14" FontWeight="Bold" Foreground="#d97706" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Chi tiết hóa đơn" FontSize="16" FontWeight="SemiBold" Foreground="#0B1C30" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" BorderBrush="#bacdf2" BorderThickness="1" CornerRadius="12" VerticalAlignment="Top">
                        <Grid>
                            <Border x:Name="MaskBM5" Background="White" CornerRadius="11"/>
                            <Grid>
                                <Grid.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=MaskBM5}" Stretch="None" AlignmentX="Left" AlignmentY="Top"/>
                                </Grid.OpacityMask>

                                <Border Background="White"/>
                                <Border Height="46" Background="#d6e4ff" VerticalAlignment="Top" CornerRadius="11,11,0,0"/>

                                <DataGrid ItemsSource="{Binding DanhSachChiTiet}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" HorizontalGridLinesBrush="#bacdf2" VerticalGridLinesBrush="#bacdf2" Background="Transparent" BorderThickness="0" RowHeight="45" AlternatingRowBackground="#F8F9FF" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="BẬC" Binding="{Binding BacText}" Width="1.5*" ElementStyle="{StaticResource CenterText}"/>
                                        <DataGridTextColumn Header="ĐƠN GIÁ" Binding="{Binding DonGia, StringFormat=\{0:N0\}}" Width="1.5*" ElementStyle="{StaticResource CenterText}"/>
                                        <DataGridTextColumn Header="ĐỊNH MỨC THỰC TẾ" Binding="{Binding DinhMucThucTeText}" Width="2*" ElementStyle="{StaticResource CenterText}"/>
                                        <DataGridTextColumn Header="ĐIỆN NĂNG TIÊU THỤ" Binding="{Binding DienNangTieuThu}" Width="2*" ElementStyle="{StaticResource CenterText}"/>
                                        <DataGridTextColumn Header="THÀNH TIỀN" Binding="{Binding ThanhTien, StringFormat=\{0:N0\}}" Width="2*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="20,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#e74a3b"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessStatus}" Value="True">
                                        <Setter Property="Foreground" Value="#1cc88a"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕  THOÁT" Command="{Binding ThoatCommand}" FontWeight="Bold" Width="120" Height="40" Background="White" Margin="0,0,15,0" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </Button.Resources>
                            <Button.Effect>
                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                            </Button.Effect>
                        </Button>

                        <Button Content="🧾 LẬP HÓA ĐƠN" Command="{Binding LuuCommand}" FontWeight="Bold" Width="150" Height="40" Background="#0058BE" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </Button.Resources>
                            <Button.Effect>
                                <DropShadowEffect Color="#2563eb" Direction="270" ShadowDepth="3" BlurRadius="12" Opacity="0.4"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>