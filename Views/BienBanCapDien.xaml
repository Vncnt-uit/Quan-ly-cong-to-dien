<UserControl x:Class="Quản_lý_công_tơ_điện.Views.BienBanCapDien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="950"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,-20,0,40" HorizontalAlignment="Center">
            <TextBlock FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#305CF7" Offset="0"/>
                        <GradientStop Color="#7F9EFB" Offset="0.6"/>
                        <GradientStop Color="#CCE1FF" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
                <Run Text="Biên bản cấp điện"/>
            </TextBlock>
            <TextBlock Text="Vui lòng hoàn tất thông tin để thực hiện cấp điện" FontSize="14" Foreground="#475569" HorizontalAlignment="Center" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="20,0,20,15">
            <Grid>
                <Grid.Effect>
                    <DropShadowEffect Color="#FFFFFF" Direction="315" ShadowDepth="2" BlurRadius="15" Opacity="0.15"/>
                </Grid.Effect>

                <Border Background="#60FFFFFF" BorderBrush="White" BorderThickness="2" CornerRadius="15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Mã biên bản" FontSize="25" FontWeight="SemiBold" Foreground="#545997" Margin="0,0,0,20"/>
                        <Border CornerRadius="12.5" Height="35" Background="#E9ECEF" Opacity="0.8">
                            <TextBlock Text="{Binding MaBienBan}" Foreground="#6b87f2" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Grid>
                    <Grid.Effect>
                        <DropShadowEffect Color="#FFFFFF" Direction="315" ShadowDepth="2" BlurRadius="15" Opacity="0.15"/>
                    </Grid.Effect>

                    <Border Background="#60FFFFFF" BorderBrush="White" BorderThickness="2" CornerRadius="15" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Thông tin cấp điện" FontSize="25" FontWeight="SemiBold" Foreground="#545997" Margin="0,0,0,20"/>

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="MÃ PHIẾU CẤP ĐIỆN" FontWeight="Bold" Margin="0,0,0,5" Foreground="#464650" FontSize="11"/>
                                <Border CornerRadius="12.5" Height="30" Background="White" Padding="3,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMaPhieuError}" Value="True">
                                                    <Setter Property="BorderBrush" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBox Text="{Binding SelectedMaPhieu, UpdateSourceTrigger=LostFocus}" 
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             VerticalContentAlignment="Center" 
                                             Padding="8,0,8,0"/>        
                                </Border>
                                <TextBlock Text="{Binding MaPhieuErrorMessage}" Foreground="Red" FontSize="11" FontStyle="Italic" Visibility="{Binding HasMaPhieuError, Converter={StaticResource BoolToVis}}" Margin="5,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="THỜI GIAN BẮT ĐẦU CẤP ĐIỆN" FontWeight="Bold" Margin="0,0,0,5" Foreground="#464650" FontSize="11"/>
                                    <Border CornerRadius="12.5" Height="30" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" Padding="3">
                                        <DatePicker SelectedDate="{Binding ThoiGianBatDau, UpdateSourceTrigger=PropertyChanged}" DisplayDateStart="{Binding NgayHienTai}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="3,2,3,2"/>
                                    </Border>
                                    <TextBlock Text="{Binding DateErrorMessage}" Foreground="Red" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Visibility="{Binding HasDateError, Converter={StaticResource BoolToVis}}" Margin="5,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="NGÀY LẬP" FontWeight="Bold" Margin="0,0,0,5" Foreground="#464650" FontSize="11"/>
                                    <Border CornerRadius="12.5" Height="30" Background="#E9ECEF" BorderBrush="#FFDDDDDD" BorderThickness="1">
                                        <TextBox Text="{Binding NgayLap}" IsReadOnly="True" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0,8,0" Foreground="#555555"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="HỌ TÊN KHÁCH HÀNG" FontWeight="Bold" Margin="0,0,0,5" Foreground="#464650" FontSize="11"/>
                                    <Border CornerRadius="12.5" Height="30" Background="#E9ECEF" BorderBrush="#FFDDDDDD" BorderThickness="1">
                                        <TextBox Text="{Binding HoTen}" IsReadOnly="True" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0,8,0" Foreground="#555555"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="SỐ PHA ĐĂNG KÝ" FontWeight="Bold" Margin="0,0,0,5" Foreground="#464650" FontSize="11"/>
                                    <Border CornerRadius="12.5" Height="30" Background="#E9ECEF" BorderBrush="#FFDDDDDD" BorderThickness="1">
                                        <TextBox Text="{Binding SoPhaDangKy}" IsReadOnly="True" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0,8,0" Foreground="#555555"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,5">
                                <TextBlock Text="ĐỊA CHỈ CẤP ĐIỆN" FontWeight="Bold" Margin="0,0,0,5" Foreground="#464650" FontSize="11"/>
                                <Border CornerRadius="12.5" Height="73" Background="#E9ECEF" BorderBrush="#FFDDDDDD" BorderThickness="1">
                                    <TextBox Text="{Binding DiaChi}" IsReadOnly="True" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,8,8,8" VerticalAlignment="Top" Foreground="#555555"/>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold" FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,35,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#e74a3b"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccessStatus}" Value="True">
                                    <Setter Property="Foreground" Value="#1cc88a"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>


            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <Grid>
                    <Grid.Effect>
                        <DropShadowEffect Color="#FFFFFF" Direction="315" ShadowDepth="2" BlurRadius="15" Opacity="0.15"/>
                    </Grid.Effect>

                    <Border Background="#60FFFFFF" BorderBrush="White" BorderThickness="2" CornerRadius="15" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Thông tin công tơ điện" FontSize="25" FontWeight="SemiBold" Foreground="#545997" Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="MÃ CÔNG TƠ ĐIỆN" FontWeight="Bold" Margin="0,0,0,5" Foreground="#464650" FontSize="11"/>
                                    <Border CornerRadius="12.5" Height="30" Background="White">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMaCongToError}" Value="True">
                                                        <Setter Property="BorderBrush" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox Text="{Binding MaCongTo, UpdateSourceTrigger=LostFocus}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0,8,0"/>
                                    </Border>
                                    <TextBlock Text="{Binding MaCongToErrorMessage}" Foreground="Red" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Visibility="{Binding HasMaCongToError, Converter={StaticResource BoolToVis}}" Margin="5,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="LOẠI CÔNG TƠ ĐIỆN" FontWeight="Bold" Margin="0,0,0,5" Foreground="#464650" FontSize="11"/>

                                    <Border CornerRadius="16" Height="32" Background="White" Padding="5,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#e0e0e0"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLoaiCongToError}" Value="True">
                                                        <Setter Property="BorderBrush" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <ComboBox ItemsSource="{Binding DanhSachLoaiCongTo}" 
                                                  SelectedItem="{Binding TenLoaiCongTo, UpdateSourceTrigger=PropertyChanged}" 
                                                  Background="Transparent" 
                                                  BorderThickness="0" 
                                                  VerticalContentAlignment="Center" 
                                                  IsEditable="True" 
                                                  IsReadOnly="True" 
                                                  Cursor="Arrow" 
                                                  ForceCursor="True">
                                            <ComboBox.Resources>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                    <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
                                                    <Setter Property="ForceCursor" Value="True"/>
                                                </Style>
                                            </ComboBox.Resources>
                                        </ComboBox>
                                    </Border>

                                    <TextBlock Text="{Binding LoaiCongToErrorMessage}" Foreground="Red" FontSize="11" FontStyle="Italic" Visibility="{Binding HasLoaiCongToError, Converter={StaticResource BoolToVis}}" Margin="5,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="HÃNG SẢN XUẤT" FontWeight="Bold" Margin="0,0,0,5" Foreground="#464650" FontSize="11"/>
                                    <Border CornerRadius="12.5" Height="30" Background="White">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasHangSanXuatError}" Value="True">
                                                        <Setter Property="BorderBrush" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox Text="{Binding HangSanXuat, UpdateSourceTrigger=LostFocus}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0,8,0"/>
                                    </Border>
                                    <TextBlock Text="{Binding HangSanXuatErrorMessage}" Foreground="Red" FontSize="11" FontStyle="Italic" Visibility="{Binding HasHangSanXuatError, Converter={StaticResource BoolToVis}}" Margin="5,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="NĂM SẢN XUẤT" FontWeight="Bold" Margin="0,0,0,5" Foreground="#464650" FontSize="11"/>
                                    <Border CornerRadius="12.5" Height="30" Background="White">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNamSanXuatError}" Value="True">
                                                        <Setter Property="BorderBrush" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox Text="{Binding NamSanXuat, UpdateSourceTrigger=LostFocus}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0,8,0"/>
                                    </Border>
                                    <TextBlock Text="{Binding NamSanXuatErrorMessage}" Foreground="Red" FontSize="11" FontStyle="Italic" Visibility="{Binding HasNamSanXuatError, Converter={StaticResource BoolToVis}}" Margin="5,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="CHỈ SỐ BAN ĐẦU" FontWeight="Bold" Margin="0,0,0,5" Foreground="#464650" FontSize="11"/>
                                    <Border CornerRadius="12.5" Height="30" Background="White">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasChiSoError}" Value="True">
                                                        <Setter Property="BorderBrush" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox Text="{Binding ChiSoBanDau, UpdateSourceTrigger=LostFocus}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0,8,0"/>
                                    </Border>
                                    <TextBlock Text="{Binding ChiSoErrorMessage}" Foreground="Red" FontSize="11" FontStyle="Italic" Visibility="{Binding HasChiSoError, Converter={StaticResource BoolToVis}}" Margin="5,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>


                            <StackPanel Margin="0,0,0,5">
                                <TextBlock Text="VỊ TRÍ LẮP ĐẶT" FontWeight="Bold" Margin="0,0,0,5" Foreground="#464650" FontSize="11"/>
                                <Border CornerRadius="12.5" Height="73" Background="White">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasViTriError}" Value="True">
                                                    <Setter Property="BorderBrush" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBox Text="{Binding ViTriLapDat, UpdateSourceTrigger=LostFocus}" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalAlignment="Top" Padding="8,8,8,8"/>
                                </Border>
                                <TextBlock Text="{Binding ViTriErrorMessage}" Foreground="Red" FontSize="11" FontStyle="Italic" Visibility="{Binding HasViTriError, Converter={StaticResource BoolToVis}}" Margin="5,2,0,0"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,35,0,0">
                    <Button Content="✕  THOÁT" Command="{Binding ThoatCommand}" FontWeight="Bold" Width="120" Height="40" Background="White" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17.5"/>
                            </Style>
                        </Button.Resources>

                        <Button.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                        </Button.Effect>

                    </Button>

                    <Button Content="LẬP BIÊN BẢN ⌲" Command="{Binding LuuCommand}" FontWeight="Bold" Width="140" Height="40" Background="#4A72FF" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17.5"/>
                            </Style>
                        </Button.Resources>

                        <Button.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                        </Button.Effect>

                    </Button>
                </StackPanel>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>