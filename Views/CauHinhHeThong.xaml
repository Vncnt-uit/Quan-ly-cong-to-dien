<UserControl x:Class="Quản_lý_công_tơ_điện.Views.CauHinhHeThong"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100" 
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#cbd5e1"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#cbd5e1"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
            </Style.Resources>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#d6e4ff"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3b5998"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#bacdf2"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5,0,0,5"/>
        </Style>
        
        <Style x:Key="CenterTextBox" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#2563eb"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Stretch" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="32" FontWeight="Bold" Margin="0,0,0,5">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#6b87f2" Offset="0"/>
                            <GradientStop Color="#88a1f4" Offset="0.6"/>
                            <GradientStop Color="#c3caf8" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    <Run Text="Cấu hình Hệ thống"/>
                </TextBlock>
                <TextBlock Text="Quản lý cách tính giá điện, mục đích sử dụng và cấu hình cấp điện." FontSize="15" Foreground="#555555" FontWeight="SemiBold"/>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Margin="0,0,20,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#e74a3b"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccessStatus}" Value="True">
                                <Setter Property="Foreground" Value="#1cc88a"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Border Grid.Row="1" Background="#60FFFFFF" BorderBrush="#ffffff" BorderThickness="2" CornerRadius="15" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="20" Opacity="0.08"/>
            </Border.Effect>

            <TabControl Background="Transparent" BorderThickness="0">

                <TabItem Header="Quy định Giá điện">
                    <Grid Margin="10,20,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Thiết lập cách tính giá điện" FontSize="16" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,15"/>

                        <Border Grid.Row="1" BorderBrush="#bacdf2" BorderThickness="1" CornerRadius="12" VerticalAlignment="Top" VirtualizingPanel.ScrollUnit="Pixel">
                            <Grid>
                                <Border x:Name="MaskTab1" Background="White" CornerRadius="11"/>
                                <Grid>
                                    <Grid.OpacityMask>
                                        <VisualBrush Visual="{Binding ElementName=MaskTab1}" Stretch="None" AlignmentX="Left" AlignmentY="Top"/>
                                    </Grid.OpacityMask>
                                    <Border Background="White"/>
                                    <Border Height="46" Background="#d6e4ff" VerticalAlignment="Top" CornerRadius="11,11,0,0"/>

                                    <DataGrid ItemsSource="{Binding DanhSachQuyDinhGia}" SelectedItem="{Binding SelectedQuyDinhGia}" 
                                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                              GridLinesVisibility="All" HorizontalGridLinesBrush="#bacdf2" VerticalGridLinesBrush="#bacdf2"
                                              Background="Transparent" BorderThickness="0" RowHeight="40" AlternatingRowBackground="#eff4fd"
                                              VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="BẬC" Binding="{Binding Bac}" IsReadOnly="True" Width="0.5*" ElementStyle="{StaticResource CenterText}"/>
                                            <DataGridTextColumn Header="ĐƠN GIÁ (VNĐ)" Binding="{Binding DonGia, StringFormat=\{0:N0\}, TargetNullValue=0}" Width="1*" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterTextBox}"/>
                                            <DataGridTextColumn Header="ĐỊNH MỨC (kWh)" Binding="{Binding DinhMuc, TargetNullValue={x:Null}}" Width="1*" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterTextBox}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="+THÊM BẬC" Command="{Binding ThemBacCommand}" Width="110" Height="40" Background="#1cc88a" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="20"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="-XÓA BẬC" Command="{Binding XoaBacCommand}" Width="110" Height="40" Background="#e74a3b" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,30,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="20"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="💾 LƯU THAY ĐỔI" Command="{Binding LuuGiaDienCommand}" Width="160" Height="40" Background="#2563eb" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="20"/>
                                    </Style>
                                </Button.Resources>
                                <Button.Effect>
                                    <DropShadowEffect Color="#2563eb" Direction="270" ShadowDepth="3" BlurRadius="12" Opacity="0.4"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Mục đích &amp; Cấu hình cấp điện">
                    <Grid Margin="10,20,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="95"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="1. Quản lý Mục đích sử dụng" FontSize="16" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="1" Margin="0,0,0,15" VerticalAlignment="Top">
                                <TextBlock Text="Tên mục đích mới" Style="{StaticResource FormLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="16" Height="34" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,10,0" Padding="10,0">
                                        <TextBox Text="{Binding TenMucDichMoi, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" FontWeight="Normal"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="THÊM" Command="{Binding ThemMucDichCommand}" Width="90" Height="34" Background="#3b82f6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="17"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding TenMucDichErrorMessage}" Visibility="{Binding HasTenMucDichError, Converter={StaticResource BoolToVis}}" 
                                           Foreground="#e74a3b" FontSize="12" FontStyle="Italic" FontWeight="Normal" Margin="10,5,0,0" MinHeight="15"/>
                            </StackPanel>

                            <Border Grid.Row="2" BorderBrush="#bacdf2" BorderThickness="1" CornerRadius="12" VerticalAlignment="Top">
                                <Grid>
                                    <Border x:Name="MaskTab2Left" Background="White" CornerRadius="11"/>
                                    <Grid>
                                        <Grid.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=MaskTab2Left}" Stretch="None" AlignmentX="Left" AlignmentY="Top"/>
                                        </Grid.OpacityMask>
                                        <Border Background="White"/>
                                        <Border Height="46" Background="#d6e4ff" VerticalAlignment="Top" CornerRadius="11,11,0,0"/>

                                        <DataGrid ItemsSource="{Binding DanhSachMucDich}" SelectedItem="{Binding SelectedMucDich}" 
                                                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                                  GridLinesVisibility="All" HorizontalGridLinesBrush="#bacdf2" VerticalGridLinesBrush="#bacdf2"
                                                  Background="Transparent" BorderThickness="0" RowHeight="40" AlternatingRowBackground="#eff4fd">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="MÃ MỤC ĐÍCH" Binding="{Binding MaMucDich}" IsReadOnly="True" Width="0.6*" ElementStyle="{StaticResource CenterText}"/>
                                                <DataGridTextColumn Header="TÊN MỤC ĐÍCH" Binding="{Binding TenMucDich}" IsReadOnly="True" Width="1*" ElementStyle="{StaticResource CenterText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Button Grid.Row="3" Content="XÓA MỤC ĐÍCH" Command="{Binding XoaMucDichCommand}" 
                                    HorizontalAlignment="Right" Margin="0,15,0,0" Width="160" Height="35" 
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="#fee2e2"/>
                                        <Setter Property="Foreground" Value="#dc2626"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#f1f5f9"/>
                                                <Setter Property="Foreground" Value="#94a3b8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="17"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="95"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="2. Quản lý Cấu hình cấp điện" FontSize="16" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="1" Margin="0,0,0,15" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Mục đích sử dụng" Style="{StaticResource FormLabel}"/>
                                        <Border CornerRadius="16" Height="34" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" Padding="3,2">
                                            <ComboBox ItemsSource="{Binding DanhSachMucDich}" DisplayMemberPath="TenMucDich" SelectedItem="{Binding SelectedMucDichToAdd}" 
                                                      Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Margin="5,0"
                                                      IsEditable="True" IsReadOnly="True" Cursor="Arrow" ForceCursor="True" FontWeight="Normal">
                                                <ComboBox.Resources>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                        <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
                                                        <Setter Property="ForceCursor" Value="True"/>
                                                    </Style>
                                                </ComboBox.Resources>
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Loại pha" Style="{StaticResource FormLabel}"/>
                                        <Border CornerRadius="16" Height="34" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" Padding="3,2">
                                            <ComboBox ItemsSource="{Binding DanhSachLoaiPha}" DisplayMemberPath="TenSoPha" SelectedItem="{Binding SelectedLoaiPhaToAdd}" 
                                                      Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Margin="5,0"
                                                      IsEditable="True" IsReadOnly="True" Cursor="Arrow" ForceCursor="True" FontWeight="Normal">
                                                <ComboBox.Resources>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                        <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
                                                        <Setter Property="ForceCursor" Value="True"/>
                                                    </Style>
                                                </ComboBox.Resources>
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="THÊM" Command="{Binding ThemCauHinhCommand}" VerticalAlignment="Bottom" Width="90" Height="34" Background="#3b82f6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="17"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="2" BorderBrush="#bacdf2" BorderThickness="1" CornerRadius="12" VerticalAlignment="Top">
                                <Grid>
                                    <Border x:Name="MaskTab2Right" Background="White" CornerRadius="11"/>
                                    <Grid>
                                        <Grid.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=MaskTab2Right}" Stretch="None" AlignmentX="Left" AlignmentY="Top"/>
                                        </Grid.OpacityMask>
                                        <Border Background="White"/>
                                        <Border Height="46" Background="#d6e4ff" VerticalAlignment="Top" CornerRadius="11,11,0,0"/>

                                        <DataGrid ItemsSource="{Binding DanhSachCauHinh}" SelectedItem="{Binding SelectedCauHinh}" 
                                                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                                  GridLinesVisibility="All" HorizontalGridLinesBrush="#bacdf2" VerticalGridLinesBrush="#bacdf2"
                                                  Background="Transparent" BorderThickness="0" RowHeight="40" AlternatingRowBackground="#eff4fd">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="MỤC ĐÍCH SỬ DỤNG" Binding="{Binding TenMucDich}" IsReadOnly="True" Width="1*" ElementStyle="{StaticResource CenterText}"/>
                                                <DataGridTextColumn Header="LOẠI PHA" Binding="{Binding TenSoPha}" IsReadOnly="True" Width="0.5*" ElementStyle="{StaticResource CenterText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Button Grid.Row="3" Content="XÓA CẤU HÌNH" Command="{Binding XoaCauHinhCommand}" 
                                    HorizontalAlignment="Right" Margin="0,15,0,0" Width="160" Height="35" 
                                    Padding="15,0" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="#fee2e2"/>
                                        <Setter Property="Foreground" Value="#dc2626"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#f1f5f9"/>
                                                <Setter Property="Foreground" Value="#94a3b8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="17"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>