<UserControl x:Class="Quản_lý_công_tơ_điện.BM2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950" Background="White">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#ced4da"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#ced4da"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,10,30,20" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="MÃ BIÊN BẢN" FontSize="13" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,6"/>
            <Border Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="1" CornerRadius="6" Padding="15,10">
                <TextBlock x:Name="lblMaBienBan" Text="&lt;Tự động sinh&gt;" Foreground="Black" FontWeight="Bold" FontSize="18"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Thông tin cấp điện" FontSize="20" FontWeight="Bold" Foreground="#3b5998" Margin="0,0,0,15"/>

                <TextBlock Text="MÃ PHIẾU CẤP ĐIỆN" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="cboMaPhieu" Margin="0,0,0,15" SelectionChanged="cboMaPhieu_SelectionChanged"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="THỜI GIAN BẮT ĐẦU CẤP ĐIỆN" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DatePicker x:Name="dtpThoiGianBatDau" SelectedDateChanged="CheckIfFormIsEmpty"/>

                        <TextBlock x:Name="lblDateError" 
                                     Text="* Ngày bắt đầu không được trước ngày lập phiếu!" 
                                     Foreground="#e74c3c" FontSize="11" Margin="0,4,0,0" 
                                     Visibility="Collapsed" FontStyle="Italic"
                                     TextWrapping="Wrap"/>
                        
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NGÀY LẬP" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="lblNgayLap" IsReadOnly="True" Background="#e9ecef"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="HỌ TÊN KHÁCH HÀNG" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtHoTen" IsReadOnly="True" Background="#e9ecef"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SỐ PHA ĐĂNG KÝ" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtSoPhaDangKy" IsReadOnly="True" Background="#e9ecef" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="ĐỊA CHỈ CẤP ĐIỆN" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="txtDiaChi" 
                           IsReadOnly="True" 
                           Background="#e9ecef" 
                           Height="70" 
                           TextWrapping="Wrap"
                           VerticalContentAlignment="Top" 
                           Padding="8,6"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Thông tin công tơ điện" FontSize="20" FontWeight="Bold" Foreground="#3b5998" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MÃ CÔNG TƠ ĐIỆN" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtMaCongTo" 
                                   TextChanged="CheckIfFormIsEmpty" 
                                   LostFocus="txtMaCongTo_LostFocus" 
                                   FontWeight="SemiBold" Foreground="#2c3e50"/>

                        <TextBlock x:Name="lblMaCongToError" 
                                     Text="* Mã công tơ này đã được sử dụng!" 
                                     Foreground="#e74c3c" FontSize="11" Margin="0,4,0,0" 
                                     Visibility="Collapsed" FontStyle="Italic"
                                     TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="LOẠI CÔNG TƠ ĐIỆN" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cboLoaiCongTo" SelectionChanged="CheckIfFormIsEmpty"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="lblLoaiCongToHint" Text="* Vui lòng chọn Mã phiếu trước để lọc loại công tơ" FontStyle="Italic" Foreground="#e67e22" FontSize="11" Margin="0,-10,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="HÃNG SẢN XUẤT" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtHangSanXuat" TextChanged="CheckIfFormIsEmpty"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NĂM SẢN XUẤT" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtNamSanXuat" TextChanged="CheckIfFormIsEmpty"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="CHỈ SỐ BAN ĐẦU" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="txtChiSoBanDau" TextChanged="CheckIfFormIsEmpty" Margin="0,0,0,15"/>

                <TextBlock Text="VỊ TRÍ LẮP ĐẶT" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="txtViTriLapDat" 
                           TextChanged="CheckIfFormIsEmpty" 
                           Height="50" 
                           AcceptsReturn="True" 
                           Margin="0,0,0,25"
                           VerticalContentAlignment="Top" 
                           Padding="8,6"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnHuy" Content="HỦY" Width="110" Height="38" Background="White" BorderBrush="Gray" Margin="0,0,15,0" Click="btnHuy_Click"/>
                    <Button x:Name="btnLuu" Content="LẬP BIÊN BẢN" Width="150" Height="38" Background="#4e73df" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="btnLuu_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>